# FleetPilot AI - Environment Variables
# Copy this to .env and fill in your values.

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/fleetpilot

# Google Gemini (optional — used if GROQ_API_KEY is not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq (preferred — fast inference, generous free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Resend Email (leave empty to simulate email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=fleet@yourdomain.com

# NHTSA
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

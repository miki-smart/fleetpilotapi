# FleetPilot AI - Environment Variables
# Copy this to .env and fill in your values.

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/fleetpilot

# Google Gemini — primary AI provider. Free key from https://aistudio.google.com (no card).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq — optional alternative provider, switchable at runtime in Settings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Resend Email (free tier: 100/day, 3,000/month). Leave the key empty to simulate delivery.
# Without a verified domain Resend only delivers from onboarding@resend.dev to the
# address that owns the Resend account — set FLEET_MANAGER_EMAIL to that address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=FleetPilot <onboarding@resend.dev>
FLEET_MANAGER_EMAIL=

# NHTSA (free, no key): vPIC VIN decoding + open recall campaigns
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_RECALLS_BASE_URL=https://api.nhtsa.gov

# Proactive automation (in-process scheduler; external schedulers can also call the API)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Addis_Ababa
SCAN_SCHEDULE_CRON=0 6 * * *
SCAN_INTERVAL_MINUTES=0
# Shared secret that Cloud Scheduler / GitHub Actions must send as X-Scheduler-Token
SCHEDULER_TOKEN=
# Remind the manager when approvals wait longer than this many hours
APPROVAL_REMINDER_HOURS=24

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
